# inemaVOX - Variaveis de ambiente
# Copie este arquivo para .env e preencha os valores

# HuggingFace Token - necessario para diarizacao de multiplos falantes
# 1. Crie uma conta em https://huggingface.co
# 2. Aceite os termos do modelo em https://hf.co/pyannote/speaker-diarization-3.1
# 3. Gere um token em https://hf.co/settings/tokens
# 4. Cole o token abaixo
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Freesound.org API Key - necessario para features de Musica e SFX
# 1. Crie uma conta gratuita em https://freesound.org
# 2. Registre um cliente de API em https://freesound.org/apiv2/apply/
# 3. Copie a 'Client secret (API key)' e cole abaixo
# Sem esta key, as features Musica e SFX do menu nao funcionam
FREESOUND_API_KEY=
